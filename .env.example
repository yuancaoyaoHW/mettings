# Milvus 向量库
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DB_NAME=
MILVUS_COLLECTION_NAME=

# Embedding 服务
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_NAME=

# LLM 服务
# 方案1: 使用 OpenAI / Azure
# LLM_API_KEY=your-api-key
# LLM_BASE_URL=https://api.openai.com
# LLM_MODEL_NAME=gpt-3.5-turbo

# 方案2: 使用自部署 Qwen3-30B-A3B（推荐）
LLM_API_KEY=your-api-key-or-empty
LLM_BASE_URL=http://localhost:8000/v1  # 你的 Qwen3 服务地址
LLM_MODEL_NAME=Qwen3-30B-A3B

# Rerank（可选）
RERANK_BASE_URL=
RERANK_MODEL_NAME=

# 智能纪要：上下文 token 上限、默认召回条数、字符/token 粗算（中文约 4）
CONTEXT_TOKEN_BUDGET=8000
DEFAULT_TOP_K=5
CHARS_PER_TOKEN=4
# 会议类型模板（JSON/YAML 文件路径，推荐）
SMART_MINUTES_TEMPLATES_PATH=config/templates.json
# 会议类型模板（JSON 字符串，可选；仅在未设置 SMART_MINUTES_TEMPLATES_PATH 时生效）
SMART_MINUTES_TEMPLATES_JSON=

# 映射表 DB（口头→人名、会议类型→专业词，可选）
# 推荐优先使用统一 URI：
# MAPPING_DB_URI=mysql://user:pass@host:3306/smart_minutes
MAPPING_DB_URI=
# 兼容独立配置：仅在未设置 MAPPING_DB_URI 时生效
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=smart_minutes
